# Start.ps1 generates distinct random credentials; this file contains placeholders.
WALLETLEDGER_DB_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
WALLETLEDGER_RUNTIME_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_RUNTIME_PASSWORD
WALLETLEDGER_RECEIPT_SECRET=REPLACE_WITH_STABLE_PRIVATE_64_HEX_SECRET
DATABASE_URL=postgresql://walletledger_runtime:REPLACE_WITH_DIFFERENT_RANDOM_RUNTIME_PASSWORD@127.0.0.1:5462/walletledger
WALLETLEDGER_MIGRATION_URL=postgresql://walletledger:REPLACE_WITH_RANDOM_OWNER_PASSWORD@127.0.0.1:5462/walletledger
WALLETLEDGER_TEST_ADMIN_URL=postgresql://walletledger:REPLACE_WITH_RANDOM_OWNER_PASSWORD@127.0.0.1:5462/postgres
WALLETLEDGER_ALLOWED_ORIGINS=http://127.0.0.1:8170,http://localhost:8170,http://127.0.0.1:8171,http://127.0.0.1:5175,http://localhost:5175
WALLETLEDGER_COOKIE_SECURE=false
